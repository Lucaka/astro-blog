---
import { getCollection } from "astro:content";
import { byDateDesc, postPath, localePrefix } from "../../utils/posts";
import { useTranslations } from "../../i18n";
import { LOCALE_META, type Locale } from "../../i18n/config";
import LanguageSwitch from "../LanguageSwitch.astro";
import ReadingModeBoot from "../ReadingModeBoot.astro";
import ReadingModeToggle from "../ReadingModeToggle.astro";
import SiteRouter from "../SiteRouter.astro";
import "../../styles/global.css";
import "../../styles/document.css";

/**
 * Themed 404: GitHub Pages serves the built `404.html` for any unknown URL
 * under the site, so a mistyped or moved post link lands here instead of the
 * default GitHub error page. Lists every post so lost readers have somewhere
 * to go. Shared by the zh-hant `/404` and English `/en/404`.
 */
interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const localeMeta = LOCALE_META[locale];

const entries = (await getCollection("posts")).sort(byDateDesc);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}${localePrefix(locale)}/`;
---

<html lang={localeMeta.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<SiteRouter />
		<ReadingModeBoot />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{t("notFound.docTitle")}</title>
		<meta name="robots" content="noindex" />
		<meta name="theme-color" content="#05070f" />
	</head>
	<body class="doc doc--lost">
		<main class="lost doc-main">
			<div class="lost__lang">
				<LanguageSwitch locale={locale} path="" />
				<ReadingModeToggle locale={locale} />
			</div>
			<p class="lost__code" aria-hidden="true">404</p>
			<h1 class="lost__title">{t("notFound.title")}</h1>
			<p class="lost__text">
				{t("notFound.text")}
			</p>
			<a class="lost__home" href={home}>{t("notFound.backHome")}</a>

			<section class="lost__posts">
				<h2>{t("notFound.postsHeading")}</h2>
				<ul>
					{
						entries.map((entry) => (
							<li>
								<a href={postPath(entry.id, locale)}>{entry.data.title}</a>
								<span class="lost__date">{entry.data.date}</span>
							</li>
						))
					}
				</ul>
			</section>
		</main>
	</body>
</html>

<style is:global>
	/* doc-main's top padding is tighter than a 404 needs; this page stands alone. */
	.lost.doc-main {
		padding-top: clamp(48px, 12vh, 120px);
		padding-bottom: calc(64px + var(--safe-b));
	}
	.lost__lang {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 4px 8px;
		margin-bottom: 12px;
	}
	.lost__code {
		margin: 0;
		background: linear-gradient(
			180deg,
			var(--color-accent) 0%,
			var(--color-accent-deep) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-size: clamp(64px, 14vw, 110px);
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1;
	}
	.lost__title {
		margin: 18px 0 8px;
		font-size: clamp(22px, 4.5vw, 30px);
		line-height: 1.3;
	}
	.lost__text {
		margin: 0 0 20px;
		color: var(--color-ink-body);
		font-size: 15px;
		line-height: 1.7;
	}
	.lost__home {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--color-accent);
		font-size: 15px;
		text-decoration: none;
	}
	.lost__home:hover,
	.lost__home:focus-visible {
		color: var(--color-accent-strong);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.lost__posts {
		margin-top: 48px;
	}
	.lost__posts h2 {
		color: var(--color-ink-meta);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.08em;
	}
	.lost__posts ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.lost__posts li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px 16px;
		min-height: 44px;
		padding: 10px 0;
		border-bottom: 1px solid var(--color-line);
	}
	.lost__posts a {
		min-width: 0;
		color: var(--color-ink);
		overflow-wrap: anywhere;
		text-decoration: none;
	}
	.lost__posts a:hover,
	.lost__posts a:focus-visible {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.lost__date {
		flex: none;
		color: var(--color-ink-meta);
		font-size: 14px;
	}

	@media (max-width: 480px) {
		.lost__posts li {
			flex-wrap: wrap;
		}
	}
</style>
