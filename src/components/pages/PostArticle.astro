---
import { render, type CollectionEntry } from "astro:content";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { CATEGORY_META } from "../../data/posts";
import { catColor } from "../../utils/categories";
import {
	parseDisplayDate,
	readingTimeMinutes,
	postPath,
	localePrefix,
} from "../../utils/posts";
import { useTranslations } from "../../i18n";
import {
	LOCALES,
	LOCALE_META,
	DEFAULT_LOCALE,
	type Locale,
} from "../../i18n/config";
import LanguageSwitch from "../LanguageSwitch.astro";
import ReadingModeBoot from "../ReadingModeBoot.astro";
import ReadingModeToggle from "../ReadingModeToggle.astro";
import ReadingProgress from "../ReadingProgress.astro";
import SiteRouter from "../SiteRouter.astro";
import { tagSlug, tagPath, tagsIndexPath } from "../../utils/tags";
import "../../styles/global.css";
import "../../styles/document.css";
import type { TranslationEntry } from "../../utils/translations";

/**
 * Shared post document, rendered by both `/posts/[slug]` (zh-hant) and
 * `/en/posts/[slug]`. A non-default locale shows a real translation when a
 * `<slug>.en.md` sibling exists (`translation`); otherwise it falls back to the
 * original's content — the chrome stays localized, the body stays in the source
 * language, and `canonical` points at the original so the untranslated
 * duplicate consolidates instead of competing in search. `date`, `category` and
 * `tags` always come from the original so a translation never drifts on those.
 */
type Entry = CollectionEntry<"posts">;
interface Props {
	locale: Locale;
	entry: Entry;
	newer: Entry | null;
	older: Entry | null;
	/** The `<slug>.<locale>.md` translation for this post, if one exists. */
	translation?: TranslationEntry | null;
}
const { locale, entry, newer, older, translation = null } = Astro.props;
const t = useTranslations(locale);
const localeMeta = LOCALE_META[locale];

// A translation pair exists for this post (used for hreflang on BOTH locales);
// this page is showing it only when we're on the non-default locale.
const hasTranslation = translation != null;
const showingTranslation = hasTranslation && locale !== DEFAULT_LOCALE;

const { Content, headings } = await render(
	showingTranslation ? translation : entry,
);
const toc = headings.filter(
	(heading) => heading.depth === 2 || heading.depth === 3,
);
const { date, category, tags } = entry.data;
const title = showingTranslation ? translation.data.title : entry.data.title;
const summary = showingTranslation
	? translation.data.summary
	: entry.data.summary;

const meta = CATEGORY_META[category];
const color = catColor(category);
const olderColor = older ? catColor(older.data.category) : color;
const newerColor = newer ? catColor(newer.data.category) : color;
const minutes = readingTimeMinutes(entry.body ?? "");
const published = parseDisplayDate(date);

// A non-default locale with no translation shows the original as a fallback.
const isFallback = locale !== DEFAULT_LOCALE && !hasTranslation;
const bodyLang = isFallback ? LOCALE_META[DEFAULT_LOCALE].htmlLang : undefined;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const prefix = localePrefix(locale);
const home = `${base}${prefix}/`;
const feed = `${base}${prefix}/rss.xml`;
const ogImage = new URL(`${base}/og/${entry.id}.png`, Astro.site);
// Brand identity URL for structured data (locale-agnostic site root).
const siteUrl = new URL(`${base}/`, Astro.site);
const isoDate = published.toISOString().slice(0, 10);

// Self URL for this locale; the canonical points at the original for a
// fallback page so untranslated duplicates don't compete in search.
const selfUrl = new URL(postPath(entry.id, locale), Astro.site);
const canonical = isFallback
	? new URL(postPath(entry.id, DEFAULT_LOCALE), Astro.site)
	: selfUrl;

// Reciprocal hreflang only once a real translation exists — advertised on
// BOTH locales' pages so they point at each other. Until then there is no true
// alternate (the /en/ page is a fallback, canonical'd back to the original).
const alternates = hasTranslation
	? LOCALES.map((l) => ({
			hreflang: LOCALE_META[l].htmlLang,
			href: getAbsoluteLocaleUrl(l, `posts/${entry.id}/`),
		}))
	: [];

// Structured data for search engines: this page is a blog post.
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description: summary,
	datePublished: isoDate,
	// We have no separate "modified" date, so it mirrors the published date.
	dateModified: isoDate,
	author: { "@type": "Person", name: "James", url: siteUrl },
	publisher: {
		"@type": "Organization",
		name: t("site.name"),
		logo: { "@type": "ImageObject", url: ogImage },
	},
	keywords: tags.join(", "),
	articleSection: meta.label,
	// The body's real language: the source language while falling back.
	inLanguage: isFallback
		? LOCALE_META[DEFAULT_LOCALE].htmlLang
		: localeMeta.htmlLang,
	image: ogImage,
	mainEntityOfPage: canonical,
	url: selfUrl,
	// JSON.stringify leaves "</" intact, so a title/summary containing
	// "</script>" could break out of the inline script tag; escape "<".
}).replace(/</g, "\\u003c");
---

<html lang={localeMeta.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<SiteRouter />
		<ReadingModeBoot />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title} {t("post.docTitleSuffix")}</title>
		<meta name="description" content={summary} />
		<link rel="canonical" href={canonical} />
		{
			alternates.map((a) => (
				<link rel="alternate" hreflang={a.hreflang} href={a.href} />
			))
		}
		{
			hasTranslation && (
				<link
					rel="alternate"
					hreflang="x-default"
					href={getAbsoluteLocaleUrl(DEFAULT_LOCALE, `posts/${entry.id}/`)}
				/>
			)
		}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={t("site.name")}
			href={feed}
		/>
		<meta name="theme-color" content="#05070f" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta property="og:type" content="article" />
		<meta property="og:locale" content={localeMeta.ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={summary} />
		<meta property="og:url" content={selfUrl} />
		<meta property="og:site_name" content={t("site.name")} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="article:published_time" content={published.toISOString()} />
		<meta property="article:modified_time" content={published.toISOString()} />
		<meta property="article:author" content="James" />
		<meta property="article:section" content={meta.label} />
		{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={summary} />
		<meta name="twitter:image" content={ogImage} />
		<script is:inline type="application/ld+json" set:html={jsonLd} />
	</head>
	<body class="doc doc--article">
		<a class="skip-link" href="#article">{t("post.skip")}</a>

		<header class="site-header">
			<a class="back-link" href={home}>{t("post.back")}</a>
			<div class="site-header__end">
				<LanguageSwitch locale={locale} path={`posts/${entry.id}/`} />
				<ReadingModeToggle locale={locale} />
				<a class="feed-link" href={feed}>{t("post.rss")}</a>
			</div>
		</header>

		<ReadingProgress color={color} />

		<main id="article" class="post doc-main">
			<div class="post-layout">
				<article>
					<div class="post__hero" style={`--post-accent: ${color}`}>
						<div class="post__glow" aria-hidden="true"></div>
						<p class="post__category" style={`color: ${color}`}>
							<span class="post__dot" style={`background: ${color}`}></span>
							{meta.label}
						</p>
						<h1 class="post__title">{title}</h1>
						<p class="post__meta">
							<time datetime={published.toISOString().slice(0, 10)}>{date}</time
							>
							<span aria-hidden="true">·</span>
							{t("post.readingTime", { minutes })}
						</p>
						<ul class="post__tags" aria-label={t("post.tagsLabel")}>
							{
								tags.map((tag) => (
									<li>
										<a href={tagPath(tagSlug(tag), locale)}>{tag}</a>
									</li>
								))
							}
						</ul>
						<p class="post__summary">{summary}</p>
					</div>
					{
						isFallback && (
							<p class="post__untranslated" lang={localeMeta.htmlLang}>
								{t("post.untranslatedNotice")}
							</p>
						)
					}
					<div class="post__body prose" lang={bodyLang}>
						<Content />
					</div>

					{
						(newer || older) && (
							<nav class="post-nav" aria-label={t("post.navLabel")}>
								{older ? (
									<a
										class="post-nav__card"
										href={postPath(older.id, locale)}
										rel="prev"
										style={`--card-accent: ${olderColor}`}
									>
										<span class="post-nav__hint">{t("post.older")}</span>
										<span class="post-nav__title">{older.data.title}</span>
									</a>
								) : (
									<span class="post-nav__spacer" />
								)}
								{newer ? (
									<a
										class="post-nav__card post-nav__card--next"
										href={postPath(newer.id, locale)}
										rel="next"
										style={`--card-accent: ${newerColor}`}
									>
										<span class="post-nav__hint">{t("post.newer")}</span>
										<span class="post-nav__title">{newer.data.title}</span>
									</a>
								) : (
									<span class="post-nav__spacer" />
								)}
							</nav>
						)
					}
				</article>
				{
					toc.length > 0 && (
						<nav class="toc" aria-label={t("post.tocLabel")}>
							<p class="toc__label">{t("post.toc")}</p>
							<ol>
								{toc.map((heading) => (
									<li
										class:list={[
											"toc__item",
											{ "toc__item--sub": heading.depth === 3 },
										]}
									>
										<a href={`#${heading.slug}`}>
											{heading.text.replace(/#$/, "")}
										</a>
									</li>
								))}
							</ol>
						</nav>
					)
				}
			</div>
		</main>

		<footer class="site-footer">
			<a href={home}>{t("site.name")}</a> — {t("footer.tagline")} ·
			<a href={tagsIndexPath(locale)}>{t("tags.browse")}</a>
		</footer>
	</body>
</html>

<style is:global>
	.post-layout {
		min-width: 0;
	}

	.post__hero {
		position: relative;
	}
	.post__glow {
		position: absolute;
		z-index: -1;
		top: -1.25rem;
		left: 0;
		width: min(28rem, 100%);
		height: 8.5rem;
		background: radial-gradient(
			ellipse at 20% 45%,
			color-mix(in srgb, var(--post-accent) 50%, transparent),
			transparent 70%
		);
		pointer-events: none;
	}

	.post__untranslated {
		margin: 0 0 20px;
		padding: 10px 14px;
		border-radius: var(--radius-control);
		border: 1px solid rgb(255 204 102 / 0.35);
		border-left: 3px solid var(--color-warn);
		background: rgb(255 204 102 / 0.08);
		color: var(--color-warn-ink);
		font-size: var(--text-reading);
		line-height: 1.6;
	}

	.post__category {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		margin: 0;
		font-size: var(--text-meta);
		font-weight: 600;
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}
	.post__dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.post__title {
		margin: 14px 0 8px;
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1.2;
		scroll-margin-top: 5rem;
	}
	.post__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		color: var(--color-ink-meta);
		font-size: var(--text-reading);
	}
	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 18px 0;
		padding: 0;
		list-style: none;
	}
	.post__tags a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 4px 10px;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-chip);
		background: var(--color-fill);
		color: var(--color-ink-soft);
		font-size: var(--text-meta);
		text-decoration: none;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.post__tags a:hover,
	.post__tags a:focus-visible {
		border-color: rgb(138 180 255 / 0.5);
		background: rgb(138 180 255 / 0.16);
		color: var(--color-ink);
	}
	.post__summary {
		margin: 8px 0 24px;
		color: var(--color-ink-body);
		font-size: var(--text-lead);
		line-height: 1.6;
	}

	.post-nav {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-line);
	}
	.post-nav__card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
		padding: 1rem 1.05rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-card);
		background: var(--color-fill);
		color: var(--color-ink);
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease;
	}
	.post-nav__card--next {
		text-align: right;
	}
	.post-nav__hint {
		color: var(--card-accent, var(--color-accent));
		font-size: var(--text-meta);
	}
	.post-nav__title {
		color: var(--color-ink-body);
		font-size: var(--text-reading);
		line-height: 1.4;
		overflow-wrap: anywhere;
	}
	.post-nav__card:hover,
	.post-nav__card:focus-visible {
		transform: translateY(-3px);
		border-color: color-mix(
			in srgb,
			var(--card-accent, var(--color-accent)) 55%,
			transparent
		);
		box-shadow:
			var(--shadow-lift),
			0 0 22px
				color-mix(
					in srgb,
					var(--card-accent, var(--color-accent)) 34%,
					transparent
				);
	}
	.post-nav__card:hover .post-nav__title,
	.post-nav__card:focus-visible .post-nav__title {
		color: var(--color-ink);
	}
	.post-nav__spacer {
		display: none;
	}

	.toc {
		display: none;
	}

	@media (min-width: 640px) {
		.post-nav {
			grid-template-columns: 1fr 1fr;
		}
		.post-nav__card--next {
			grid-column: 2;
		}
	}

	@media (min-width: 1100px) {
		body.doc--article {
			--doc-width: 1080px;
		}
		.post-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 220px;
			column-gap: 2.5rem;
			align-items: start;
		}
		.toc {
			display: block;
			position: sticky;
			top: 1.5rem;
			max-height: calc(100dvh - 3rem);
			overflow: auto;
			padding-left: 1rem;
			border-left: 1px solid var(--color-line);
		}
		.toc__label {
			margin: 0 0 0.55rem;
			color: var(--color-ink-meta);
			font-size: var(--text-caption);
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}
		.toc ol {
			margin: 0;
			padding: 0;
			list-style: none;
		}
		.toc a {
			display: block;
			padding: 0.3rem 0;
			color: var(--color-ink-meta);
			font-size: var(--text-meta);
			line-height: 1.45;
			text-decoration: none;
			overflow-wrap: anywhere;
		}
		.toc__item--sub a {
			padding-left: 0.85rem;
			font-size: var(--text-caption);
		}
		.toc a:hover,
		.toc a:focus-visible {
			color: var(--color-accent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-nav__card {
			transition: none;
		}
		.post-nav__card:hover,
		.post-nav__card:focus-visible {
			transform: none;
		}
	}
</style>
