---
import type { CollectionEntry } from "astro:content";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { postPath, localePrefix } from "../../utils/posts";
import { catColor, catLabel } from "../../utils/categories";
import { tagSlug, tagPath, tagsIndexPath } from "../../utils/tags";
import { useTranslations } from "../../i18n";
import {
	LOCALES,
	LOCALE_META,
	DEFAULT_LOCALE,
	type Locale,
} from "../../i18n/config";
import LanguageSwitch from "../LanguageSwitch.astro";
import ReadingModeBoot from "../ReadingModeBoot.astro";
import ReadingModeToggle from "../ReadingModeToggle.astro";
import SiteRouter from "../SiteRouter.astro";
import "../../styles/global.css";
import "../../styles/document.css";

type PostEntry = CollectionEntry<"posts">;

/**
 * One static, indexable page per tag: a topic-cluster landing page that lists
 * every post carrying the tag, newest first. Shared by the zh-hant
 * `/tags/[tag]/` and English `/en/tags/[tag]/`; the listed post titles aren't
 * translated, but the chrome is, so the two are advertised as reciprocal
 * hreflang alternates. `getStaticPaths` lives in the page wrappers.
 */
interface Props {
	locale: Locale;
	tag: string;
	posts: PostEntry[];
}
const { locale, tag, posts } = Astro.props;
const t = useTranslations(locale);
const localeMeta = LOCALE_META[locale];
const slug = tagSlug(tag);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}${localePrefix(locale)}/`;
const feed = `${base}${localePrefix(locale)}/rss.xml`;
const canonical = new URL(tagPath(slug, locale), Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
const description = t("tags.pageDescription", { tag, count: posts.length });
const pageLabel = t("tags.pageLabel", { tag });
const docTitle = `${pageLabel} ${t("post.docTitleSuffix")}`;

const alternates = LOCALES.map((l) => ({
	hreflang: LOCALE_META[l].htmlLang,
	href: getAbsoluteLocaleUrl(l, `tags/${slug}/`),
}));
const xDefaultHref = getAbsoluteLocaleUrl(DEFAULT_LOCALE, `tags/${slug}/`);

// Structured data: a collection page listing the tagged posts.
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: pageLabel,
	description,
	url: canonical,
	inLanguage: localeMeta.htmlLang,
	isPartOf: {
		"@type": "Blog",
		name: t("site.name"),
		url: new URL(home, Astro.site),
	},
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: posts.length,
		itemListElement: posts.map((post, i) => ({
			"@type": "ListItem",
			position: i + 1,
			url: new URL(postPath(post.id, locale), Astro.site),
			name: post.data.title,
		})),
	},
}).replace(/</g, "\\u003c");
---

<html lang={localeMeta.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<SiteRouter />
		<ReadingModeBoot />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{docTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{
			alternates.map((a) => (
				<link rel="alternate" hreflang={a.hreflang} href={a.href} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={t("site.name")}
			href={feed}
		/>
		<meta name="theme-color" content="#05070f" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={localeMeta.ogLocale} />
		<meta property="og:site_name" content={t("site.name")} />
		<meta property="og:title" content={pageLabel} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t("og.imageAlt")} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageLabel} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script is:inline type="application/ld+json" set:html={jsonLd} />
	</head>
	<body class="doc">
		<a class="skip-link" href="#tag-list">{t("tags.skipToList")}</a>

		<header class="site-header">
			<a class="back-link" href={home}>{t("post.back")}</a>
			<div class="site-header__end">
				<LanguageSwitch locale={locale} path={`tags/${slug}/`} />
				<ReadingModeToggle locale={locale} />
				<a class="feed-link" href={tagsIndexPath(locale)}
					>{t("tags.allTitle")}</a
				>
			</div>
		</header>

		<main id="tag-list" class="tag-page doc-main">
			<p class="tag-page__eyebrow">
				<a href={tagsIndexPath(locale)}>{t("tags.eyebrow")}</a>
				<span aria-hidden="true">/</span>
			</p>
			<h1 class="tag-page__title doc-title">{tag}</h1>
			<p class="tag-page__count">
				{t("tags.postCount", { count: posts.length })}
			</p>

			<ul class="tag-list">
				{
					posts.map((post) => {
						const color = catColor(post.data.category);
						return (
							<li class="tag-list__item">
								<a
									class="tag-list__link"
									href={postPath(post.id, locale)}
									style={`--card-accent: ${color}`}
								>
									<span class="tag-list__cat" style={`color: ${color}`}>
										<span
											class="tag-list__dot"
											style={`background: ${color}`}
										/>
										{catLabel(post.data.category)}
									</span>
									<span class="tag-list__heading">{post.data.title}</span>
									<span class="tag-list__summary">{post.data.summary}</span>
									<span class="tag-list__date">{post.data.date}</span>
								</a>
							</li>
						);
					})
				}
			</ul>
		</main>

		<footer class="site-footer">
			<a href={home}>{t("site.name")}</a> — {t("footer.tagline")}
		</footer>
	</body>
</html>

<style is:global>
	.tag-page__eyebrow {
		display: flex;
		gap: 8px;
		margin: 0;
		color: var(--color-ink-meta);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-label);
	}
	.tag-page__eyebrow a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--color-accent);
		text-decoration: none;
	}
	.tag-page__eyebrow a:hover {
		color: var(--color-accent-strong);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.tag-page .doc-title {
		margin-top: 10px;
	}
	.tag-page__count {
		margin: 0 0 28px;
		color: var(--color-ink-meta);
		font-size: var(--text-reading);
	}

	.tag-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tag-list__link {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
		padding: 16px 18px;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-card);
		background: var(--color-fill);
		color: var(--color-ink);
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}
	.tag-list__link:hover,
	.tag-list__link:focus-visible {
		transform: translateY(-3px);
		border-color: color-mix(
			in srgb,
			var(--card-accent, var(--color-accent)) 55%,
			transparent
		);
		background: var(--color-fill-strong);
		box-shadow:
			var(--shadow-lift),
			0 0 24px
				color-mix(
					in srgb,
					var(--card-accent, var(--color-accent)) 36%,
					transparent
				);
	}
	.tag-list__cat {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		font-size: var(--text-caption);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.tag-list__dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.tag-list__heading {
		font-size: var(--text-card-title);
		font-weight: 600;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}
	.tag-list__link:hover .tag-list__heading,
	.tag-list__link:focus-visible .tag-list__heading {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.tag-list__summary {
		color: var(--color-ink-body);
		font-size: var(--text-reading);
		line-height: 1.6;
	}
	.tag-list__date {
		color: var(--color-ink-meta);
		font-size: var(--text-meta);
	}

	@media (prefers-reduced-motion: reduce) {
		.tag-list__link {
			transition: none;
		}
		.tag-list__link:hover,
		.tag-list__link:focus-visible {
			transform: none;
		}
	}
</style>
