---
import { getCollection } from "astro:content";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { tagSlug, tagPath, tagsIndexPath } from "../../utils/tags";
import { localePrefix } from "../../utils/posts";
import { catColor } from "../../utils/categories";
import type { PostCategory } from "../../data/posts";
import { useTranslations } from "../../i18n";
import {
	LOCALES,
	LOCALE_META,
	DEFAULT_LOCALE,
	type Locale,
} from "../../i18n/config";
import LanguageSwitch from "../LanguageSwitch.astro";
import ReadingModeBoot from "../ReadingModeBoot.astro";
import ReadingModeToggle from "../ReadingModeToggle.astro";
import SiteRouter from "../SiteRouter.astro";
import "../../styles/global.css";
import "../../styles/document.css";

/**
 * The tag directory: a single crawlable hub linking to every per-tag page.
 * This is what gives the tag cluster internal links from one place (the post
 * pages link individual tags; this lists them all). Sorted by frequency so the
 * biggest topics lead, then alphabetically for a stable order. Shared by the
 * zh-hant `/tags/` and English `/en/tags/`; the localized chrome makes the two
 * real alternates, advertised with reciprocal hreflang.
 */
interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const localeMeta = LOCALE_META[locale];

const entries = await getCollection("posts");

const counts = new Map<
	string,
	{ count: number; cats: Map<PostCategory, number> }
>();
for (const entry of entries) {
	for (const tag of entry.data.tags) {
		const rec = counts.get(tag) ?? { count: 0, cats: new Map() };
		rec.count += 1;
		rec.cats.set(
			entry.data.category,
			(rec.cats.get(entry.data.category) ?? 0) + 1,
		);
		counts.set(tag, rec);
	}
}

const countValues = [...counts.values()].map((rec) => rec.count);
const countMin = Math.min(...countValues);
const countMax = Math.max(...countValues);

function dominantCategory(cats: Map<PostCategory, number>): PostCategory {
	let best: PostCategory = "blog";
	let n = -1;
	for (const [cat, count] of cats) {
		if (count > n) {
			best = cat;
			n = count;
		}
	}
	return best;
}

const tags = [...counts.entries()]
	.map(([tag, rec]) => {
		const span = countMax - countMin;
		const size =
			span === 0 ? 1.15 : 0.95 + ((rec.count - countMin) / span) * 1.1;
		return {
			tag,
			count: rec.count,
			slug: tagSlug(tag),
			color: catColor(dominantCategory(rec.cats)),
			size: size.toFixed(3),
		};
	})
	.sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = `${base}${localePrefix(locale)}/`;
const feed = `${base}${localePrefix(locale)}/rss.xml`;
const canonical = new URL(tagsIndexPath(locale), Astro.site);
const ogImage = new URL(`${base}/og.png`, Astro.site);
const description = t("tags.indexDescription", { count: tags.length });
const docTitle = `${t("tags.allTitle")} ${t("post.docTitleSuffix")}`;

const alternates = LOCALES.map((l) => ({
	hreflang: LOCALE_META[l].htmlLang,
	href: getAbsoluteLocaleUrl(l, "tags/"),
}));
const xDefaultHref = getAbsoluteLocaleUrl(DEFAULT_LOCALE, "tags/");

const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: docTitle,
	description,
	url: canonical,
	inLanguage: localeMeta.htmlLang,
	isPartOf: {
		"@type": "Blog",
		name: t("site.name"),
		url: new URL(home, Astro.site),
	},
}).replace(/</g, "\\u003c");
---

<html lang={localeMeta.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<SiteRouter />
		<ReadingModeBoot />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{docTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{
			alternates.map((a) => (
				<link rel="alternate" hreflang={a.hreflang} href={a.href} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={t("site.name")}
			href={feed}
		/>
		<meta name="theme-color" content="#05070f" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={localeMeta.ogLocale} />
		<meta property="og:site_name" content={t("site.name")} />
		<meta property="og:title" content={docTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t("og.imageAlt")} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={docTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script is:inline type="application/ld+json" set:html={jsonLd} />
	</head>
	<body class="doc">
		<header class="site-header">
			<a class="back-link" href={home}>{t("post.back")}</a>
			<div class="site-header__end">
				<LanguageSwitch locale={locale} path="tags/" />
				<ReadingModeToggle locale={locale} />
				<a class="feed-link" href={feed}>{t("post.rss")}</a>
			</div>
		</header>

		<main class="tags-index doc-main">
			<h1 class="tags-index__title doc-title">{t("tags.allTitle")}</h1>
			<p class="tags-index__sub doc-sub">
				{t("tags.indexSub", { count: tags.length })}
			</p>

			<ul class="tag-cloud" aria-label={t("tags.cloudLabel")}>
				{
					tags.map(({ tag, count, slug, color, size }) => (
						<li>
							<a
								class="tag-cloud__link"
								href={tagPath(slug, locale)}
								style={`--tag-color: ${color}; --tag-size: ${size}`}
							>
								<span class="tag-cloud__name">{tag}</span>
								<span class="tag-cloud__count">{count}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>

		<footer class="site-footer">
			<a href={home}>{t("site.name")}</a> — {t("footer.tagline")}
		</footer>
	</body>
</html>

<style is:global>
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.95rem;
		margin: 0;
		padding: 0.5rem 0 0;
		list-style: none;
	}
	.tag-cloud__link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		max-width: 100%;
		min-height: 44px;
		padding: 0.15rem 0.1rem;
		color: var(--tag-color);
		font-size: calc(var(--tag-size) * 1rem);
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		text-shadow: 0 0 18px color-mix(in srgb, var(--tag-color) 40%, transparent);
		overflow-wrap: anywhere;
	}
	.tag-cloud__link:hover,
	.tag-cloud__link:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
	.tag-cloud__count {
		color: var(--color-ink-meta);
		font-size: 0.62em;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		text-shadow: none;
	}
</style>
